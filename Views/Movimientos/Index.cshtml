@model IEnumerable<InventarioApp.Models.MovimientoInventario>

@{
    ViewData["Title"] = "Movimientos";
    int currentPage = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 200;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
}

<div class="page-header">
    <h1>Movimientos de Inventario</h1>
    <a asp-action="Create" class="btn-primary">Registrar Movimiento</a>
</div>

<div class="paginacion-resumen">
    Mostrando pagina @currentPage de @totalPages (@totalRecords registros totales).
</div>

<div class="tabla-contenedor">
    <table class="tabla-inventario">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Producto</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Observacion</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var claseTipo = item.Tipo == TipoMovimiento.Entrada ? "badge-ok" : "badge-critico";
            <tr>
                <td>@item.Fecha.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.Producto?.Nombre</td>
                <td><span class="@claseTipo">@item.Tipo</span></td>
                <td>@item.Cantidad</td>
                <td>@item.Observacion</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="paginacion-contenedor">
     <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : string.Empty)"
         asp-action="Index"
         asp-route-page="@(currentPage - 1)"
         asp-route-pageSize="@pageSize">Anterior</a>

     <span class="paginacion-actual">Pagina @currentPage / @totalPages</span>

     <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : string.Empty)"
         asp-action="Index"
         asp-route-page="@(currentPage + 1)"
         asp-route-pageSize="@pageSize">Siguiente</a>
</div>
